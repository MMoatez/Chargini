MONGODB_URI=mongodb://127.0.0.1:27017/chargini
PORT=3000
NODE_ENV=development
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret

# SMTP account used to email password-reset codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Chargini <no-reply@chargini.tn>
